# Auto detect text files and perform LF normalization
* text=auto

# Ore integrity hashes must not depend on the checkout platform.
common/src/main/resources/assets/apricityui/apricity/apricityui/theme/ore/** text eol=lf
common/src/main/resources/assets/apricityui/apricity/apricityui/theme/ore/fonts/** -text

# Keep the generated Vue runtime and its refresh tools byte-stable across platforms.
common/src/main/resources/assets/apricityui/apricity/apricityui/runtime/** text eol=lf
scripts/runtime/** text eol=lf
