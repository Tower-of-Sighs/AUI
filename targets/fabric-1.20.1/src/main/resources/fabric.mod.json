{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.sighs.apricityui.fabric.ApricityUIFabric"],
    "client": ["com.sighs.apricityui.fabric.ApricityUIFabricClient"]
  },
  "mixins": [
    "apricityui.fabric.mixins.json"
  ],
  "accessWidener": "apricityui.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "rhino": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=17"
  }
}
