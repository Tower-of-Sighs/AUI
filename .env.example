# publish-all.sh 需要的凭据。复制为 .env 并填入真实值；.env 被 .gitignore 忽略。
CURSEFORGE_TOKEN=
MODRINTH_TOKEN=
SIGHS_PUBLISH_USER=
SIGHS_PUBLISH_PASSWORD=

# 可选：publish-all.sh 会按各 target 的 ci.properties（ci.java）挑 Gradle JVM，
# 这里给出对应版本的 JAVA_HOME。没设的版本会退回当前 JAVA_HOME。
# 各 target 要求：fabric-1.20.1=17；forge-* / fabric-1.21.1 / neoforge-1.21.1=21；26.1 系=25。
JAVA_HOME_17=
JAVA_HOME_21=
JAVA_HOME_25=
